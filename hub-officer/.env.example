# ======================= Aplicação =======================
# APP_ENV=production exige FOUNDER_TOKEN diferente de change-me
APP_ENV=development
LOG_LEVEL=INFO
# No Railway: https://seu-dominio.com (usado em JSON-LD, sitemap e llms.txt)
PUBLIC_BASE_URL=http://localhost:8000
BRAND_NAME=Hub Semântico BR
# all | api | worker
OFFICE_ROLE=all
OFFICE_AUTOSTART=true

# ======================= Persistência ====================
# Local: SQLite. Railway: ${{Postgres.DATABASE_URL}} (postgres:// é convertido automaticamente)
DATABASE_URL=sqlite+aiosqlite:///./office.db
# Vazio = barramento em memória (processo único). Railway: ${{Redis.REDIS_URL}}
REDIS_URL=

# ======================= LLM =============================
# free (IAs gratuitas em rodízio) | anthropic | openai | gemini | mock (offline, dados fictícios)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modelo por tier: CVO / scouts+especialistas / Score Agent.
# Para reduzir custo, use claude-sonnet-5-5 ou claude-haiku-5-5 nos tiers worker/judge.
MODEL_STRATEGIC=claude-opus-5-5
MODEL_WORKER=claude-opus-5-5
MODEL_JUDGE=claude-opus-5-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-pro
LLM_MAX_TOKENS=16000
MOCK_SIMULATE_COST=true

# --- IAs gratuitas (LLM_PROVIDER=free) ---
# Rotas "provedor:modelo" separadas por |, tentadas em ordem; se uma bater no limite (429), usa a próxima.
# Provedores: groq | gemini | openrouter (modelos :free ou openrouter/free) | ollama (local) | openai (pago)
# Os modelos e limites grátis mudam com frequência: confira no painel de cada provedor.
# Teste as rotas com:  python -m app.llm.free_client
FREE_LLM_ROUTES=groq:llama-3.3-70b-versatile|gemini:gemini-2.5-flash|openrouter:openrouter/free
FREE_LLM_ROUTES_STRATEGIC=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
FREE_LLM_MAX_TOKENS=4096
# Máximo de chamadas de IA por dia (0 = sem limite). Atingido, o escritório descansa até 00:00 UTC e retoma sozinho.
# Com planos grátis, comece com algo como 300 e ajuste olhando o painel.
LLM_DAILY_CALL_LIMIT=0
# Atraso por chamada no modo mock (segundos) — deixa o escritório virtual visível trabalhando
MOCK_LATENCY_SECONDS=1.5

# ======================= Governança ======================
CYCLE_INTERVAL_SECONDS=900
# 0 tudo exige aprovação | 1 publica sozinho, gasto extra exige aprovação | 2 autonomia total
AUTONOMY_LEVEL=1
DAILY_LLM_BUDGET_USD=10
MONTHLY_BUDGET_USD=300
# Estimativas rateadas por dia no ledger
INFRA_MONTHLY_COST_USD=20
DOMAIN_MONTHLY_COST_USD=5
STARTING_CASH_USD=1000
SCORE_THRESHOLD=0.75
MAX_REVISIONS=2
# Nome ou slug de um nicho do catálogo (o painel mostra a lista). Com rodízio, o CVO passa ao próximo
# nicho ativo quando o do foco já tem hub publicado.
DEFAULT_NICHE=Finanças pessoais
NICHE_ROTATION=true

# ======================= Rastreador de IA (várias IAs) =======
# Com as chaves abaixo, cada relatório pergunta a ChatGPT, Claude e/ou Perplexity (com busca na web).
# Sem nenhuma, usa a IA configurada em LLM_PROVIDER, sem busca (estimativa).
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
TRACKER_OPENAI_MODEL=gpt-4o-mini
TRACKER_OPENAI_SEARCH_TOOL=web_search
TRACKER_PERPLEXITY_MODEL=sonar
TRACKER_DEFAULT_QUERIES=20

# ======================= Comercial automático (agência) =======
# Liga o funil sem operação humana: prospecção → diagnóstico → e-mail → proposta → pagamento → entrega.
SALES_ENABLED=false
SALES_AUTO_SEND=true
SALES_DAILY_EMAIL_CAP=20
AGENCY_NAME=Agência de Visibilidade em IA
SALES_SEGMENTS=loja online de suplementos|loja online de moda|agência de turismo|loja online de cosméticos|loja online de pet shop
SALES_CITIES=São Paulo|Rio de Janeiro|Belo Horizonte|Curitiba|Porto Alegre
# Preços (hipóteses — ajuste conforme o mercado responder)
PRICE_DIAGNOSTICO_BRL=490
PRICE_MENSAL_BRL=1490
BRL_PER_USD=5.5
# Stripe: crie 2 Payment Links (um avulso, um assinatura) e um webhook para /webhooks/stripe
# com os eventos checkout.session.completed, invoice.paid e customer.subscription.deleted.
PAYMENT_LINK_DIAGNOSTICO=
PAYMENT_LINK_MENSAL=
STRIPE_WEBHOOK_SECRET=
# E-mail: use um domínio próprio com SPF, DKIM e DMARC (de preferência um subdomínio só para prospecção).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ======================= Viabilidade (metas do veredito semanal) =======
VIABILITY_ENABLED=true
VIABILITY_BOTS_DAYS=30
VIABILITY_TRACTION_DAYS=90
VIABILITY_REVENUE_DAYS=180
VIABILITY_MIN_LEADS=1

# ======================= Segurança / integrações =========
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
FOUNDER_TOKEN=change-me
# Slack/Discord incoming webhook (opcional)
ALERT_WEBHOOK_URL=
ALLOW_WEB_FETCH=true
# Módulos Python extras com skills, separados por vírgula
EXTRA_SKILL_MODULES=

# ======================= Dados da empresa (páginas Sobre, Termos, Privacidade) =======
COMPANY_LEGAL_NAME=
COMPANY_CNPJ=
CONTACT_EMAIL=
# Encarregado de dados pessoais (LGPD). Se vazio, usa CONTACT_EMAIL.
DPO_EMAIL=
COMPANY_CITY=

# ======================= Portal Next.js ===================
# URL pública do portal (quando definida, as páginas HTML deste backend redirecionam 301 para ela).
# Em produção, PUBLIC_BASE_URL deve ser igual a ela (é a URL que vai no JSON-LD e no sitemap).
PORTAL_URL=
# Segredo compartilhado com o portal (mesmo valor de REVALIDATE_SECRET no serviço portal)
REVALIDATE_SECRET=
# IndexNow (avisa Bing e outros buscadores na hora em que uma página muda). Gere com:
#   python -c "import secrets;print(secrets.token_hex(16))"
INDEXNOW_KEY=

# ======================= Radar de Ondas ===================
RADAR_ENABLED=true
# Intervalo entre varreduras (segundos). 43200 = 12 h. Cada varredura faz até ~20 buscas na web.
RADAR_INTERVAL_SECONDS=43200
# Consultas da busca (separadas por |) e feeds RSS/Atom complementares (separados por vírgula).
# Deixe vazio para usar as listas padrão definidas em app/config.py.
# RADAR_QUERIES=anúncios no ChatGPT|agentic commerce checkout|generative engine optimization
# RADAR_FEEDS=https://searchengineland.com/feed,https://www.searchenginejournal.com/feed/

# --- Modo Insighta (o escritório vira o comercial/marketing do SaaS) ---
BUSINESS=agencia                      # insighta = vende a Insighta para clínicas
INSIGHTA_APP_URL=https://insighta-rcm-frontendnovo-production.up.railway.app
INSIGHTA_LANDING_URL=                 # domínio da landing (ex.: https://insighta.com.br)
INSIGHTA_API_URL=https://insighta-rcm-backendnovo-production.up.railway.app
GOOGLE_MAPS_API_KEY=                  # Places API (New) — busca oficial de clínicas
PLACES_DAILY_CALL_CAP=10              # ~300/mês: cabe na cota grátis mensal do Google (confira)
CONTENT_ENABLED=false                 # time de Conteúdo & GEO: 1 rascunho/semana para aprovação
